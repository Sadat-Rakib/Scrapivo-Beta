+  const browserOptions = {
+    ...(deps.searchRunId ? { searchRunId: deps.searchRunId } : {}),
+    ...(deps.signal ? { signal: deps.signal } : {}),
+    ...(deps.onBrowserProgress ? { onProgress: deps.onBrowserProgress } : {}),
+    researchPlan,
+    initialCandidates: browserSeeds,
+    desiredCount,
