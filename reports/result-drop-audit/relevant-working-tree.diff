+        id: "looking",
+        label: "Just looking",
+        hint: "Browse and compare, no pitch",
+        recommended: true,
+      },
+      { id: "selling", label: "Selling something", hint: "Find buyers for an offer" },
+      { id: "hiring", label: "Hiring / recruiting", hint: "Talent or roles" },
+    ],
+    allowOther: true,
+  };
