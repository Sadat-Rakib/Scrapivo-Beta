+    throw browserResult.reason;
+  }
+
+  const browserRows = browserResult.status === "fulfilled" ? browserResult.value : [];
+  const diagnostics: ProviderDiagnostic[] = [...(source?.diagnostics ?? [])];
+  if (sourceResult.status === "rejected") {
