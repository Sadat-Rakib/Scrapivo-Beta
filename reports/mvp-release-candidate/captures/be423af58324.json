  "text": "\n    \n    \n      <div style=\"max-width: 720px; margin: 64px auto; padding: 32px 24px; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: #fdfaf2; background: #1f1f29; line-height: 1.7;\">\n        <h1 style=\"font-size: 36px; font-weight: 800; margin: 0 0 24px; color: #fdfaf2;\">Vilnius Founders</h1>\n        <p style=\"font-size: 18px; color: rgba(253, 250, 242, 0.8); margin: 0 0 16px;\">\n          A founder-first community connecting Baltic startup builders through fundraising help, events, and startup media.\n        </p>\n        <p style=\"color: rgba(253, 250, 242, 0.6); margin: 0 0 24px;\">\n          No slides. No suits. Just honest conversations and strong founder networks.\n        </p>\n        <p style=\"color: rgba(253, 250, 242, 0.6); margin: 0 0 24px;\">\n          This site is best experienced with JavaScript enabled. You can still reach us through the links below:\n        </p>\n        <ul style=\"list-style: none; padding: 0; margin: 0 0 32px;\">\n          <li style=\"margin-bottom: 12px;\">\n            <a href=\"https://form.typeform.com/to/cV16vKvz\" style=\"color: #e06bc0; text-decoration: none;\">Submit your pitch deck</a>\n          </li>\n          <li style=\"margin-bottom: 12px;\">\n            <a href=\"https://luma.com/vilnius_founders\" style=\"color: #e06bc0; text-decoration: none;\">See upcoming events on Luma</a>\n          </li>\n          <li style=\"margin-bottom: 12px;\">\n            <a href=\"https://www.instagram.com/vilnius.founders/\" style=\"color: #e06bc0; text-decoration: none;\">Follow on Instagram</a>\n          </li>\n          <li style=\"margin-bottom: 12px;\">\n            <a href=\"https://www.linkedin.com/company/vilnius-founders/\" style=\"color: #e06bc0; text-decoration: none;\">Follow on LinkedIn</a>\n          </li>\n          <li style=\"margin-bottom: 12px;\">\n            <a href=\"https://www.youtube.com/playlist?list=PLbjhfwpMWxKDnQegtIEkiihKF_SSnCPc3\" style=\"color: 