# Scrapivo environment variables
# Copy to .env and fill in values.

# ── My Supabase (auth + profiles — required for app login) ───────────
MY_SUPABASE_URL=
MY_SUPABASE_PUBLISHABLE_KEY=
MY_SUPABASE_SERVICE_ROLE_KEY=
VITE_MY_SUPABASE_URL=
VITE_MY_SUPABASE_PUBLISHABLE_KEY=

# ── Lovable / legacy Supabase (optional) ─────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ── AI classification (optional — Groq or OpenRouter) ────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Set to true to skip LLM buyer-intent verification during debugging
SKIP_LLM_CLASSIFY=false
# Set to 1 to print per-source lead counts at each pipeline stage (debug tracing)
SCRAPIVO_DEBUG_STAGES=

# ── Self-hosted web discovery (recommended for LOCAL only) ───────────
# Start SearXNG: docker compose up -d searxng
# Local: SEARXNG_URL=http://127.0.0.1:8888
# Production (Vercel): do NOT set localhost — it cannot reach your PC.
# Leave SEARXNG_URL empty on Vercel and rely on USE_PAID_SOURCES=true + SerpAPI/Tavily
# for LinkedIn/X/FB/IG, OR host SearXNG publicly and set that URL.
SEARXNG_URL=http://127.0.0.1:8888

# ── Paid Discover APIs (needed for social on Vercel) ─────────────────
# Free-first locally when Docker SearXNG is up. On Vercel serverless you MUST
# set USE_PAID_SOURCES=true and valid SERPAPI_KEY / TAVILY_API_KEY or social
# platforms will be nearly empty (Freelancer/HN still work without them).
USE_PAID_SOURCES=false
TAVILY_API_KEY=
# Prefer Serper as primary hosted Google SERP (then ScrapingDog, then SerpAPI).
SERPER_API_KEY=
SCRAPINGDOG_API_KEY=
SERPAPI_KEY=
# When SearXNG is unavailable (Vercel), SerpAPI budget defaults to 10/run.
# SERPAPI_MAX_CALLS_PER_RUN=10
# ScrapeCreators — only used when USE_PAID_SOURCES=true
SCRAPECREATORS_KEY=
# SAM.gov opportunities — independent of USE_PAID_SOURCES
SAM_GOV_KEY=

# ── Page enrichment (Crawl4AI) ───────────────────────────────────────
# Start: docker compose up -d scrape-worker
SCRAPE_WORKER_URL=http://localhost:3098

# ── Optional curl-impersonate binary path (403 bypass for Reddit etc.) ─
# CURL_IMPERSONATE_BIN=C:\path\to\curl_chrome120.exe

# ── Stealth browser worker (Playwright — gated platforms) ───────────
# Run: cd workers/stealth-worker && npm install && npx playwright install chromium && npm start
STEALTH_WORKER_URL=http://localhost:3099
STEALTH_WORKER_TOKEN=

# ── Reddit ───────────────────────────────────────────────────────────
# By DEFAULT Reddit is read via Arctic Shift, a third-party public archive:
# real-time, ~120k req/hr, no account, and — the important part — no Reddit
# Developer Terms accepted. Reddit's Responsible Builder Policy bars
# commercialising Reddit data without written approval, and that policy binds
# you through those terms. Staying logged-out keeps you outside it.
# Set REDDIT_ARCTIC_SHIFT=false to disable and fall back to OAuth/RSS.
# REDDIT_ARCTIC_SHIFT=false

# ── Reddit OAuth (OPTIONAL — accepts Reddit's Developer Terms) ────────
# Without these, Reddit is read via public RSS and 429s after ~8 requests —
# a search covers ONE subreddit. With them: 100 queries/minute, so a run
# covers all 10 and stays consistent between searches.
#
# Get them at  https://www.reddit.com/prefs/apps  (scroll to the BOTTOM,
# click "create another app...", choose type "script").
# NOT developers.reddit.com — that is Devvit, a different product for apps
# that run inside Reddit, and it does NOT give you these credentials.
#
#   CLIENT_ID     = the short unlabeled string under the app name
#   CLIENT_SECRET = the field labelled "secret"
#
# We use the client_credentials grant (app-only, read-only public data), so
# your Reddit PASSWORD is never needed or stored.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit rate-limits generic user agents harder. Put your own username here.
# REDDIT_USER_AGENT=Scrapivo/1.0 (by /u/yourusername)

# ── Optional source API keys ─────────────────────────────────────────
# Businesses search is FULLY FREE by default: OSM Nominatim+Overpass is the
# primary places/geocoding pipeline (no key needed). The keys below only add
# optional top-up sources when OSM results are thin AND a key is present.
GITHUB_TOKEN=
USAJOBS_KEY=
SAM_GOV_KEY=
# GEOAPIFY_API_KEY=          # optional top-up; geocoding works without it
# FOURSQUARE_API_KEY=        # optional top-up (Service API Key)
# ScrapeGraph (PAID managed API) is OFF unless you explicitly enable both:
# SGAI_ENABLED=1
# SGAI_API_KEY=
# SCRAPINGBEE_API_KEY is NO LONGER USED — JS-render fallback uses your own
# Crawl4AI/stealth workers (SCRAPE_WORKER_URL / STEALTH_WORKER_URL above).

# ── Optional contact enrichment ──────────────────────────────────────
# Auto Discover enrich is free-only (site crawl, profile/bio, MX, Wikidata,
# GLEIF, OpenCorporates). Paid keys run on manual "Resolve contact" / "Deep enrich".
#
# Early-stage stack: website crawl → public socials → Hunter → ZeroBounce → PDL.
# Deep enrich also needs SCRAPE_WORKER_URL and/or STEALTH_WORKER_URL (above).
OPENCORPORATES_KEY=
HUNTER_API_KEY=
PDL_API_KEY=
ZEROBOUNCE_KEY=
# MillionVerifier — preferred paid email verifier when set (never commit real keys)
MILLIONVERIFIER_API_KEY=
MILLIONVERIFIER_DAILY_CAP=40
# CoreClaw — helpful Workers only (https://github.com/cporter202/coreclaw-api-directory)
# Resolve/Deep enrich: domain-email-finder, LinkedIn company/person,
#   Instagram / YouTube / TikTok profile scrapers
# Discover Workers only when USE_PAID_SOURCES=true
CORECLAW_API_KEY=
# Optional local SMTP RCPT probe (most hosts block outbound :25). Off by default.
# Without it, catch-all detection falls back to the self-hosted verifier below,
# and addresses are reported as "probable"/"inferred" rather than "verified" —
# which is the honest answer, not a bug.
# SMTP_PROBE=true
# Identity used in the probe's EHLO / MAIL FROM (never sends mail — QUITs before DATA).
# SMTP_PROBE_HELO=scrapivo.app
# SMTP_PROBE_FROM=probe@scrapivo.app
# Cap Hunter/PDL/CoreClaw calls per process-day (default 10).
# PAID_ENRICH_DAILY_CAP=10

# ── Self-hosted email verification (free, unlimited) ─────────────────
# Either one satisfies the verification tier; whichever is up gets used first.
# Both need outbound port 25 open. Gmail-hosted domains return false negatives
# on any SMTP-based check — the verifier reports "unknown", not "invalid".
#
# Reacher / check-if-email-exists (Rust). Docker:
#   docker run -p 8080:8080 reacherhq/backend:latest
# LICENSING: dual-licensed (AGPL-3.0 / commercial). Confirm the commercial
# terms before shipping it inside a paid SaaS.
# REACHER_URL=http://localhost:8080
# REACHER_TOKEN=
# Truemail (Ruby) validation server — same role, MIT-licensed.
# TRUEMAIL_URL=http://localhost:9292
# TRUEMAIL_TOKEN=

# ── CASL outreach via Resend ─────────────────────────────────────────
# Free tier: 100 emails/day. Verify your domain in Resend (SPF/DKIM/DMARC).
RESEND_API_KEY=
# Signing secret from the Resend webhook details page (whsec_…)
RESEND_WEBHOOK_SECRET=
# Fallback from-address if not set in Settings (must be verified in Resend)
OUTREACH_FROM_EMAIL=
# Soft daily cap per user (default 50) for free-tier ramp
# OUTREACH_DAILY_CAP=50
# Public app URL for unsubscribe links
# APP_URL=https://scrapivo-beta.vercel.app
# Protects /api/cron/email-sequences (Vercel Cron sends Authorization: Bearer …)
CRON_SECRET=
# Optional dedicated HMAC secret for unsubscribe tokens (falls back to webhook secret)
# UNSUBSCRIBE_SECRET=
# Structural validation (E.164 + country plan + NANP rules) is always on and
# needs nothing. Twilio Lookup v2 BASIC is free and adds carrier-level validity.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Line Type Intelligence / Caller Name are PAID add-on packages — off unless
# you name them here, so a lead search can never generate a surprise bill.
# TWILIO_LOOKUP_PACKAGES=line_type_intelligence
# Optional: `npm i libphonenumber-js` and the phone parser upgrades to its
# full metadata automatically. Not a dependency; the built-in validator is the floor.

# ── Free registries for people & phones ──────────────────────────────
# SEC EDGAR requires a descriptive UA with a real contact address.
# SEC_EDGAR_USER_AGENT=Scrapivo/1.0 (you@example.com)
# UK Companies House — free API key, returns named directors/officers.
# https://developer.company-information.service.gov.uk/
# COMPANIES_HOUSE_API_KEY=

# -- Future / gated integrations (placeholders � not read yet) --------
# Postgres connection for live write-back (optional).
# Default path uses MY_SUPABASE_* service-role upsert into idx_*.
# Set this only if you want direct `pg` SQL; requires `npm i pg`.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Await persist in scripts: AWAIT_PERSIST_LIVE=1
# Indexed retrieval cutover (default OFF — S3 parquet stays the live path).
# When true, spec search tries the idx_* Postgres tables first and falls
# back to S3 on any error. Requires the search-index migration applied.
# USE_INDEXED_SEARCH=false
# Stripe payments (planned)
# STRIPE_SECRET_KEY=
# Algolia hosted-jobs (Workable-as-a-Service) source for the jobs upgrade.
# Empty/absent = adapter stays disabled; jobs ingestion never touches Algolia.
WAAS_ALGOLIA_KEY=
# Memory + Watches interactive hero takeover (default ON when unset).
# Set to "false" to force the legacy panels everywhere (global rollback).
# Per-page override also works without touching env: /memory?legacy=1, /watches?legacy=1.
# VITE_HERO_TAKEOVER_ENABLED=true

# ── Spec-first Discover pipeline (Phase A–D) ─────────────────────────
# Spec path is ON by default. Set false to force legacy live fan-out.
# SPEC_SEARCH_ENABLED=true
# Coverage selector (cheapest-first tiers + jobs fleet). Default ON.
# USE_COVERAGE_SELECTOR=true
# Optional JobSpy self-hosted API (Phase D). Empty = disabled.
# JOBSPY_API_URL=
# Inline contact enrichment on incomplete rows (off under vitest).
# SPEC_INLINE_ENRICH=true

# ── LLM gateways for the understanding engine ────────────────────────
# Names only. Real keys live in .env, which is gitignored — never here.
# A gateway with no key is skipped, so an empty value disables it rather
# than breaking the ladder.
#
# Each gateway carries a built-in default base URL; set the *_BASE_URL
# only when an account is served from a different host than the default.
# KiosAPI is the one to watch: its account host differs between
# dashboards, and guessing it from public docs answers 401.
OMNIROUTE_API_KEY=
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
NARAROUTER_API_KEY=
# NARAROUTER_BASE_URL=
APINEX_API_KEY=
# APINEX_BASE_URL=
KIOSAPI_API_KEY=
# KIOSAPI_BASE_URL=
TOKENFORGE_API_KEY=
# TOKENFORGE_BASE_URL=
#
# Which gateway:model pairs answer an understanding request, in order.
# Unset uses the certified ladder compiled into src/lib/ai/providers.ts.
# A model is added here only after it passes `npm run ai:probe` AND the
# semantic canary — a free model that returns 200 is not a certified one.
# UNDERSTANDING_PROVIDER_ORDER=nararouter,groq
